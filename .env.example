# Copy to .env and fill in.
DATABASE_URL="postgresql://tarabucket:tarabucket@localhost:5544/tarabucket"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change_me_min_32_chars_long_random_string"

# One-time seed of the first admin (db:seed). Change the password after first login.
SEED_ADMIN_EMAIL="admin@tarabucket.ph"
SEED_ADMIN_PASSWORD="change_me"
SEED_ADMIN_NAME="Tara Editor"
