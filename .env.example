# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Managed Postgres (Neon) — server-only, never expose to client code.
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Local Docker Postgres instead (npm run db:up):
#   postgresql://tarabucket:tarabucket@localhost:5544/tarabucket
# NOTE: db:push, db:seed and db:seed:catalog all target whatever this points at.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# REQUIRED. Min 32 chars. In production the app refuses to boot if this is missing,
# too short, or left as a "change_me" placeholder.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change_me_min_32_chars_long_random_string"

# Canonical site origin — metadata, sitemap, feed links. Real domain in prod.
# Absolute public origin, no trailing slash. Every canonical URL, the sitemap, OG tags,
# JSON-LD, and /llms.txt are built from this.
# MUST be set to the real domain in the deploy environment: NEXT_PUBLIC_* is inlined at
# BUILD time, so setting it after a build has no effect — the build ships localhost URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# One-time seed of the first admin (db:seed). SEED_ADMIN_PASSWORD is REQUIRED
# (min 8 chars) — the seed script errors rather than using a default. Change it
# after first login.
SEED_ADMIN_EMAIL="admin@tarabucket.ph"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Tara Editor"

# Optional: per-instance Postgres pool size (default 5). Keep small for serverless.
# DB_POOL_MAX="5"
